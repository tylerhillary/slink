# Copy to functions/.env and fill in. Never commit the real .env.
#
# --- Mail transport -------------------------------------------------
# Pick ONE. 'auto' uses SendGrid when a key is present, otherwise SMTP.
SLINK_MAIL_PROVIDER=auto

# Option A - SendGrid (needs a verified sender identity)
SENDGRID_API_KEY=

# Option B - Gmail SMTP (needs a 16-character Google App Password,
# NOT the account password; 2-Step Verification must be on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=skillbank0@gmail.com
SMTP_PASS=

# --- Sender identity ------------------------------------------------
SLINK_MAIL_FROM_EMAIL=skillbank0@gmail.com
SLINK_MAIL_FROM_NAME=Slink360 (Radius Technology)
SLINK_MAIL_REPLY_TO=

# --- Desk contacts --------------------------------------------------
SLINK_ADMIN_EMAIL=skillbank0@gmail.com
SLINK_SUPPORT_EMAIL=skillbank0@gmail.com
SLINK_ADMIN_PHONE=+234 812 820 4201
SLINK_SITE_URL=https://slink-beta.vercel.app
# Radius Technology’s own site. Every mention of the parent company in
# the emails links here. Leave empty and they render as plain text.
SLINK_PARENT_URL=https://radiustechnology.vercel.app

# --- Matching behaviour ---------------------------------------------
# Master switch for automatic introductions. false = acknowledgement
# emails still send, but nobody is introduced without you.
SLINK_AUTO_INTRODUCE=true

# true = only introduce genuine two-way trades (both sides teach the
# other what they asked for). false = also introduce one-way matches.
SLINK_REQUIRE_RECIPROCAL=false

# Minimum score for an automatic introduction.
#   150 = reciprocal   50 = they teach your goal   40 = you teach theirs
SLINK_MIN_MATCH_SCORE=40

# Include phone numbers in the introduction emails.
SLINK_SHARE_PHONE=true

# How many learners one member may teach at the same time. Teaching somebody
# never uses up that member's own place in the queue to learn.
SLINK_TEACH_CAPACITY=3

# Catch-up sweep
SLINK_SWEEP_MAX_AGE_DAYS=30
SLINK_SWEEP_BATCH_SIZE=40
